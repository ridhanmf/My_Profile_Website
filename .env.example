# Copy to .env and fill in, then run: npm run set-admin && npm run build
# .env is git-ignored. Only a salted PBKDF2 hash ends up in the built page.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: port for `npm start` / `npm run serve` (default 4173)
# PORT=4173

# --- KostBills on Hostinger (PHP) ---------------------------------------------------------
# These are read by the PHP API (server/api) from real environment variables or from
# api/config.php → 'env' on the server. They are listed here for reference only;
# never commit real values. See README → "KostBills: payments, WhatsApp and roles".
# PUBLIC_BASE_URL=https://ridhanfirdaus.com
# CRON_KEY=
# KOS_DEMO_ENABLED=
# PAYMENT_DRIVER=simulation
# PAYPRO_API_BASE=
# PAYPRO_MERCHANT_ID=
# PAYPRO_API_KEY=
# PAYPRO_WEBHOOK_SECRET=
# SIM_WEBHOOK_SECRET=
# WA_DRIVER=simulation
# WA_CLOUD_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_API_VERSION=v21.0
# WA_TEMPLATE_NAME=
# WA_TEMPLATE_LANG=id
